# ==============================================================================
# ArcPilot Production Configuration
# ==============================================================================

# LLM Provider Configuration ("ollama", "groq", "openai", "gemini", "mock")
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.8:27b

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b

# Provider API Keys (Set when using cloud providers)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# State Management / Redis
# If ENABLE_REDIS=false, ArcPilot uses an in-memory thread-safe state store
ENABLE_REDIS=false
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# SDLC Orchestration Parameters
MAX_REPAIR_ATTEMPTS=3
TEST_TIMEOUT=45
CODE_EXECUTION_TIMEOUT=60

# Artifacts & Workspace Storage
ARTIFACTS_DIR=artifacts

# Server Configuration
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=production
FRONTEND_URL=https://arcpilot-ke68.onrender.com
VITE_API_URL=https://arcpilot-ke68.onrender.com
