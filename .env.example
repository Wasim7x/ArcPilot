# ==============================================================================
# ArcPilot Production Configuration
# ==============================================================================

# LLM Provider Configuration ("groq", "openai", "gemini", "mock")
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Provider API Keys (Set at least one)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# State Management / Redis
# If ENABLE_REDIS=false, ArcPilot uses an in-memory thread-safe state store
ENABLE_REDIS=false
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# SDLC Orchestration Parameters
MAX_REPAIR_ATTEMPTS=3
TEST_TIMEOUT=45
CODE_EXECUTION_TIMEOUT=60

# Artifacts & Workspace Storage
ARTIFACTS_DIR=artifacts

# Server Configuration
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=production
