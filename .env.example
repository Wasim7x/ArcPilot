# ==============================================================================
# ArcPilot Environment Configuration
# ==============================================================================

# Deployment Environment: "development" or "production"
# - development: Uses local SQLite, local disk, optional local Redis.
# - production: Requires external Redis (Upstash, Redis Cloud) for checkpoints & artifacts.
#   Runs reliably on Free Render Web Service (Persistent Disk required: NO).
ENVIRONMENT=development

# LLM Provider Configuration ("groq", "openai", "gemini", "ollama", "mock")
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Provider API Keys (Set when using cloud providers)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local Ollama Configuration (When LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b

# ==============================================================================
# State & Checkpoint Persistence
# ==============================================================================
# For Local Development:
#   ENABLE_REDIS=false (defaults to thread-safe local SQLite & file store)
# For Production (Free Render):
#   ENABLE_REDIS=true
#   REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379
ENABLE_REDIS=false
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# SDLC Orchestration Parameters
MAX_REPAIR_ATTEMPTS=3
TEST_TIMEOUT=45
CODE_EXECUTION_TIMEOUT=60

# Temporary / Scratch Storage Directory
# In production on Free Render, this local directory is ephemeral.
# All critical checkpoints and project artifacts are saved to external Redis.
ARCPILOT_DATA_DIR=
ARTIFACTS_DIR=artifacts

# Server Configuration
PORT=8000
LOG_LEVEL=INFO
FRONTEND_URL=https://arcpilot-ke68.onrender.com
VITE_API_URL=https://arcpilot-ke68.onrender.com
